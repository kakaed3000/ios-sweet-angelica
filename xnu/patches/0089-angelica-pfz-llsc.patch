diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..f791e43 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -272,9 +272,22 @@ _pfz_trylock_and_enqueue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	// Try to grab the lock
+	// Try to grab the lock. Cortex-A53 is ARMv8.0 and has no LSE atomics,
+	// so fall back to a load-exclusive/store-exclusive CAS loop there.
+#if defined(__ARM_FEATURE_ATOMICS)
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_enqueue_success
+#else
+Ltrylock_enqueue_retry:
+	ldaxr	w10, [x3]	 // Atomic CAS with acquire barrier
+	cbnz	w10, Ltrylock_enqueue_failed
+	stxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_retry
+	b		Ltrylock_enqueue_success
+
+Ltrylock_enqueue_failed:
+	clrex
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_enqueue_exit
@@ -293,7 +306,7 @@ Lnon_empty_queue:
 Lset_new_tail:
 	str		x1, [x0, #8]		// Set tail = new elem
 
-	// Drop spin lock with release barrier (pairs with acquire in casa)
+	// Drop spin lock with release barrier (pairs with the acquire CAS above)
 	stlr	wzr, [x3]
 
 	mov		x0, xzr				// Mark success
@@ -319,12 +332,25 @@ _pfz_trylock_and_dequeue:
 	ARM64_STACK_PROLOG
 	PUSH_FRAME
 
-	// Try to grab the lock
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+	// Try to grab the lock. Cortex-A53 is ARMv8.0 and has no LSE atomics,
+	// so fall back to a load-exclusive/store-exclusive CAS loop there.
+#if defined(__ARM_FEATURE_ATOMICS)
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_dequeue_success
+#else
+Ltrylock_dequeue_retry:
+	ldaxr	w10, [x2]	 // Atomic CAS with acquire barrier
+	cbnz	w10, Ltrylock_dequeue_failed
+	stxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_retry
+	b		Ltrylock_dequeue_success
+
+Ltrylock_dequeue_failed:
+	clrex
+#endif
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_dequeue_exit
@@ -346,7 +372,7 @@ Lupdate_new_head:
 
 Lreturn_head:
 	mov		x0, x10			// Move head to x0
-	stlr	wzr, [x2]		// Drop spin lock with release barrier (pairs with acquire in casa)
+	stlr	wzr, [x2]		// Drop spin lock with release barrier (pairs with the acquire CAS above)
 
 Ltrylock_dequeue_exit:
 	POP_FRAME
