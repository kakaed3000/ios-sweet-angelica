diff --git a/bsd/dev/angelica_ufs.c b/bsd/dev/angelica_ufs.c
--- a/bsd/dev/angelica_ufs.c
+++ b/bsd/dev/angelica_ufs.c
@@ -671,7 +671,7 @@
  * and writable a thread copies new ring blocks to the LAST 4 MiB + 4 KiB of
  * the partition every ufslogsecs seconds (default 10), far behind the HFS
  * image at its start. Device block 0 of that area is a header:
- *   "ANGELICALOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   "ANGELICA" | u32 version 1 | u32 ring size | u64 total bytes written
  *   | u64 flush sequence
  * ring offset of byte n = n % ring size. Read it from a recovery with
  * tools/angelica-log-pull.sh. Disabled with boot-arg angelicalog=0.
@@ -767,7 +767,7 @@
 		}
 		if (!error) {
 			struct angelica_log_header h = {
-				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.magic = { 'A', 'N', 'G', 'E', 'L', 'I', 'C', 'A' },
 				.version = 1, .size = ANGELICA_LOG_SIZE, .total = total, .seq = ++seq,
 			};
 			bzero(bounce, UFS_BLOCK);
