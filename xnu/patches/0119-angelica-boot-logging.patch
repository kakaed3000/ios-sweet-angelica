--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1079,6 +1079,38 @@
 	bsd_init_kprintf("done\n");
 }
 
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+static void
+angelica_boot_heartbeat(void *arg __unused, wait_result_t result __unused)
+{
+	for (unsigned int i = 1; i <= 24; i++) {
+		proc_t p;
+		IOSleep(5000);
+		p = initproc;
+		if (p != NULL) {
+			kprintf("ANGELICA alive %u/24: init %s[%d]\n", i, p->p_name, proc_getpid(p));
+		} else {
+			kprintf("ANGELICA alive %u/24: initproc NULL\n", i);
+		}
+	}
+	kprintf("ANGELICA heartbeat: stopping after 120s\n");
+}
+
+static void
+angelica_start_boot_heartbeat(void)
+{
+	thread_t thread;
+	kern_return_t kr;
+
+	kr = kernel_thread_start((thread_continue_t)angelica_boot_heartbeat, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		kprintf("ANGELICA heartbeat: start failed %d\n", kr);
+	}
+}
+#endif
+
 void
 bsdinit_task(void)
 {
@@ -1103,9 +1135,16 @@
 	}
 #endif
 
-	bsd_init_kprintf("bsd_do_post - done");
