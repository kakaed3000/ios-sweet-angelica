+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+	angelica_start_boot_heartbeat();
+	kprintf("ANGELICA: bsd_do_post done, starting init\n");
+#endif
 	load_init_program(p);
+#if defined(ARM64_BOARD_CONFIG_ANGELICA)
+	kprintf("ANGELICA: load_init_program returned\n");
+#endif
 	lock_trace = 1;
 }
 
